# ---- shared (server + runner) ----
SLACK_BOT_TOKEN=xoxb-...
SLACK_TASK_CHANNEL=C0123456789

# ---- server only ----
# Socket Mode app-level token.
# Slack App > Basic Information > App-Level Tokens (scope: connections:write)
SLACK_APP_TOKEN=xapp-...

# ---- runner only ----
# Shell command to run when the latest task-channel message is unhandled.
COMMAND="/usr/bin/caffeinate -i /usr/local/bin/python3 /Users/me/handlers/main.py"
